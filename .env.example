# ==============================================================================
# Cartógrafo - Variables de Entorno de Ejemplo
# ==============================================================================
# Copie este archivo a `.env.local` para configurar sus variables locales:
# cp .env.example .env.local

# GitHub Personal Access Token (Opcional pero altamente recomendado):
# Permite realizar análisis de repositorios en GitHub sin caer en el límite
# estricto de 60 peticiones/hora para peticiones anónimas (sube a 5000 peticiones/hora).
# Puede generar un Classic o Fine-grained token en https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
